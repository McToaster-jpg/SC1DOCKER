{
  "name": "starcraft1-html5",
  "version": "1.0.0",
  "description": "StarCraft 1 with DLCs hosted in HTML5 on Docker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "docker:build": "docker build -t sc1-game-server:latest .",
    "docker:run": "docker run -p 5121:5121 sc1-game-server:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down"
  },
  "keywords": [
    "starcraft",
    "html5",
    "game",
    "docker",
    "multiplayer"
  ],
  "author": "mlaki",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dockerode": "^5.0.1",
    "pg": "^8.11.0"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true
  }
}
