<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />
<title>StarCraft — ${RACE_NAME}</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #05070a;
    font-family: 'Courier New', monospace;
    overflow: hidden;
  }

  .topbar {
    height: 48px;
    background: linear-gradient(180deg, #0b1210 0%, #060908 100%);
    border-bottom: 2px solid ${RACE_COLOR};
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    box-shadow: 0 0 12px ${RACE_COLOR}55;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand .icon {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 6px ${RACE_COLOR});
  }

  .brand .title {
    color: ${RACE_COLOR};
    font-weight: bold;
    letter-spacing: 3px;
    font-size: 16px;
    text-shadow: 0 0 8px ${RACE_COLOR}aa;
  }

  .brand .subtitle {
    color: #6c7a75;
    font-size: 11px;
    letter-spacing: 2px;
    margin-left: 8px;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .status .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: ${RACE_COLOR};
    box-shadow: 0 0 8px ${RACE_COLOR};
    animation: pulse 2s infinite ease-in-out;
  }

  .status .label {
    color: #9fb0aa;
    font-size: 11px;
    letter-spacing: 1px;
  }

  .back-link {
    color: ${RACE_COLOR};
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 1px;
    border: 1px solid ${RACE_COLOR}66;
    padding: 6px 12px;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    background: ${RACE_COLOR}22;
    box-shadow: 0 0 10px ${RACE_COLOR}66;
  }

  .audio-btn {
    background: transparent;
    color: ${RACE_COLOR};
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 1px;
    border: 1px solid ${RACE_COLOR}66;
    padding: 6px 12px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .audio-btn:hover {
    background: ${RACE_COLOR}22;
    box-shadow: 0 0 10px ${RACE_COLOR}66;
  }

  .audio-btn.on {
    background: ${RACE_COLOR}33;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .stage {
    height: calc(100% - 48px);
    width: 100%;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screen {
    /* 4:3 box sized to 80% of the viewport, capped by whichever
       dimension is tighter, so it stays centered and rescales live. */
    width: min(80vw, 106.66vh);
    aspect-ratio: 4 / 3;
    background: #000;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.85), 0 0 0 1px ${RACE_COLOR}33;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
</head>
<body>
  <div class="topbar">
    <div class="brand">
      <img class="icon" src="emblem.svg" alt="${RACE_NAME} emblem" />
      <span class="title">${RACE_NAME}</span>
      <span class="subtitle">STARCRAFT</span>
    </div>
    <div class="status">
      <div class="dot"></div>
      <span class="label">LIVE</span>
      <button class="audio-btn" id="audioBtn" onclick="toggleAudio()">🔇 ENABLE AUDIO</button>
      <a class="back-link" href="#" onclick="window.close(); return false;">✕ DISCONNECT</a>
    </div>
  </div>
  <div class="stage">
    <div class="screen">
      <iframe src="vnc.html?autoconnect=true&reconnect=true&resize=scale&quality=6&compression=2"></iframe>
    </div>
  </div>
  <audio id="gameAudio" preload="none"></audio>
  <script>
    var audioEl = document.getElementById('gameAudio');
    var audioBtn = document.getElementById('audioBtn');
    var audioOn = false;

    function toggleAudio() {
      if (audioOn) {
        audioEl.pause();
        audioEl.removeAttribute('src');
        audioEl.load();
        audioBtn.textContent = '🔇 ENABLE AUDIO';
        audioBtn.classList.remove('on');
        audioOn = false;
      } else {
        // Cache-bust so each connect grabs a fresh live stream instead of
        // reusing a stale buffered one from a previous session.
        audioEl.src = 'http://' + window.location.hostname + ':${AUDIO_PORT}/audio?t=' + Date.now();
        audioEl.play().catch(function (err) {
          console.warn('Audio playback failed:', err);
        });
        audioBtn.textContent = '🔊 AUDIO ON';
        audioBtn.classList.add('on');
        audioOn = true;
      }
    }
  </script>
</body>
</html>
