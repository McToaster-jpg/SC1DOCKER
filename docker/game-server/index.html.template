<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />
<title>StarCraft — ${RACE_NAME}</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #05070a;
    font-family: 'Courier New', monospace;
    overflow: hidden;
  }

  .topbar {
    height: 48px;
    background: linear-gradient(180deg, #0b1210 0%, #060908 100%);
    border-bottom: 2px solid ${RACE_COLOR};
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    box-shadow: 0 0 12px ${RACE_COLOR}55;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand .icon {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 6px ${RACE_COLOR});
  }

  .brand .title {
    color: ${RACE_COLOR};
    font-weight: bold;
    letter-spacing: 3px;
    font-size: 16px;
    text-shadow: 0 0 8px ${RACE_COLOR}aa;
  }

  .brand .subtitle {
    color: #6c7a75;
    font-size: 11px;
    letter-spacing: 2px;
    margin-left: 8px;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .status .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: ${RACE_COLOR};
    box-shadow: 0 0 8px ${RACE_COLOR};
    animation: pulse 2s infinite ease-in-out;
  }

  .status .label {
    color: #9fb0aa;
    font-size: 11px;
    letter-spacing: 1px;
  }

  .back-link {
    color: ${RACE_COLOR};
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 1px;
    border: 1px solid ${RACE_COLOR}66;
    padding: 6px 12px;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    background: ${RACE_COLOR}22;
    box-shadow: 0 0 10px ${RACE_COLOR}66;
  }

  .audio-btn {
    background: transparent;
    color: ${RACE_COLOR};
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 1px;
    border: 1px solid ${RACE_COLOR}66;
    padding: 6px 12px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .audio-btn:hover {
    background: ${RACE_COLOR}22;
    box-shadow: 0 0 10px ${RACE_COLOR}66;
  }

  .audio-btn.on {
    background: ${RACE_COLOR}33;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .stage {
    height: calc(100% - 48px);
    width: 100%;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screen {
    /* 4:3 box sized to 80% of the viewport, capped by whichever
       dimension is tighter, so it stays centered and rescales live. */
    width: min(80vw, 106.66vh);
    aspect-ratio: 4 / 3;
    background: #000;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.85), 0 0 0 1px ${RACE_COLOR}33;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
</head>
<body>
  <div class="topbar">
    <div class="brand">
      <img class="icon" src="emblem.svg" alt="${RACE_NAME} emblem" />
      <span class="title">${RACE_NAME}</span>
      <span class="subtitle">STARCRAFT</span>
    </div>
    <div class="status">
      <div class="dot"></div>
      <span class="label">LIVE</span>
      <button class="audio-btn" id="audioBtn" onclick="toggleAudio()">🔇 ENABLE AUDIO</button>
      <a class="back-link" href="#" onclick="window.close(); return false;">✕ DISCONNECT</a>
    </div>
  </div>
  <div class="stage">
    <div class="screen">
      <!-- On a LAN, bandwidth is free but compression CPU time isn't -
           push quality up and compression down for a crisper, lower-latency
           picture instead of optimizing for a constrained connection. -->
      <iframe src="vnc.html?autoconnect=true&reconnect=true&resize=scale&quality=9&compression=0"></iframe>
    </div>
  </div>
  <script>
    // Raw PCM (s16le, 48kHz stereo) streamed over a WebSocket, played back
    // via the Web Audio API instead of an <audio src> element. A plain
    // <audio> tag applies conservative buffering to any indefinite,
    // non-seekable HTTP stream by design - there's no way to override that
    // from the server side, and it was the real source of ~20s of lag even
    // after stripping every buffering layer on the encoding side. Scheduling
    // decoded samples directly against the AudioContext clock bypasses that
    // entirely.
    var audioBtn = document.getElementById('audioBtn');
    var audioCtx = null;
    var audioSocket = null;
    var nextStartTime = 0;
    var audioOn = false;
    var SAMPLE_RATE = 48000;

    function pcm16ToAudioBuffer(ctx, arrayBuffer) {
      var view = new DataView(arrayBuffer);
      var sampleCount = Math.floor(arrayBuffer.byteLength / 4); // 2ch * 2 bytes
      var buffer = ctx.createBuffer(2, sampleCount, SAMPLE_RATE);
      var left = buffer.getChannelData(0);
      var right = buffer.getChannelData(1);
      for (var i = 0; i < sampleCount; i++) {
        var offset = i * 4;
        left[i] = view.getInt16(offset, true) / 32768;
        right[i] = view.getInt16(offset + 2, true) / 32768;
      }
      return buffer;
    }

    function stopAudio() {
      if (audioSocket) {
        audioSocket.onmessage = null;
        audioSocket.close();
        audioSocket = null;
      }
      if (audioCtx) {
        audioCtx.close();
        audioCtx = null;
      }
      audioBtn.textContent = '🔇 ENABLE AUDIO';
      audioBtn.classList.remove('on');
      audioOn = false;
    }

    function startAudio() {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      // Small lead-in so the first couple of chunks have somewhere to land
      // before playback catches up to the live edge.
      nextStartTime = audioCtx.currentTime + 0.2;

      var wsProto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      audioSocket = new WebSocket(wsProto + '//' + window.location.hostname + ':${AUDIO_PORT}/');
      audioSocket.binaryType = 'arraybuffer';

      audioSocket.onmessage = function (evt) {
        if (!audioCtx) return;
        var buffer = pcm16ToAudioBuffer(audioCtx, evt.data);
        var src = audioCtx.createBufferSource();
        src.buffer = buffer;
        src.connect(audioCtx.destination);

        var now = audioCtx.currentTime;
        if (nextStartTime < now) {
          // Fell behind (backgrounded tab, GC pause, etc) - resync to the
          // live edge instead of firing a pile of overlapping buffers.
          nextStartTime = now + 0.05;
        }
        src.start(nextStartTime);
        nextStartTime += buffer.duration;
      };

      audioSocket.onerror = function (err) {
        console.warn('Audio socket error:', err);
      };

      audioSocket.onclose = function () {
        if (audioOn) stopAudio();
      };

      audioBtn.textContent = '🔊 AUDIO ON';
      audioBtn.classList.add('on');
      audioOn = true;
    }

    function toggleAudio() {
      if (audioOn) {
        stopAudio();
      } else {
        startAudio();
      }
    }
  </script>
</body>
</html>
