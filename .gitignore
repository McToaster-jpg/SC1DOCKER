# Dependencies
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock
# ...except the frontend's - keep it committed for reproducible Docker builds
!frontend/package-lock.json

# SC1 Game Files (too large for GitHub, add locally).
# Use SC1/* rather than SC1/ - an ignored directory stops git from
# descending into it at all, which silently breaks the negation below.
SC1/*
!SC1/README.md

# Environment variables
.env
.env.local
.env.*.local

# Docker
.docker
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
dist/
build/

# Game data (add your game files to .dockerignore instead)
game-data/
*.iso
*.zip

# SSL/TLS certificates
ssl/
*.pem
*.key
*.crt

# Temporary
tmp/
temp/
.cache/
